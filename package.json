{
  "name": "@maxvyshniakov/text-truncate",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "React text truncation and search highlighting, measured with Inline Measure.",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "repo-kit hooks install",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "verify": "repo-kit verify",
    "release": "repo-kit release",
    "release:publish": "repo-kit publish",
    "check:changelogs": "repo-kit check-changelogs",
    "check:kit": "repo-kit check",
    "check:consumer": "repo-kit packed-consumer",
    "security:tls": "repo-kit tls",
    "lint": "oxlint --config .oxlintrc.json --max-warnings=0 src repo-kit.config.mjs",
    "test": "vitest --config vitest.config.ts run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:fast": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@maxvyshniakov/inline-measure": "^0.2.0",
    "cn": "^0.4.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@maxvyshniakov/repo-kit": "0.2.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "oxlint": "1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxvyshniakov/text-truncate.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
