{
  "name": "@maxvyshniakov/text-truncate",
  "version": "0.3.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "React text truncation and search highlighting, measured with Inline Measure.",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "package-kit hooks install",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "verify": "package-kit verify",
    "release": "package-kit release",
    "release:publish": "package-kit publish",
    "check:changelogs": "package-kit check-changelogs",
    "check:kit": "package-kit check",
    "check:consumer": "package-kit packed-consumer",
    "lint": "oxlint --config .oxlintrc.json --max-warnings=0 src scripts/perf package-kit.config.mjs",
    "test": "node --test scripts/perf/*.test.mjs && vitest --config vitest.config.ts run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:fast": "tsc --noEmit -p tsconfig.build.json",
    "perf:capture": "slotfather run -n all --priority batch -- package-kit heavy all node scripts/perf/run.mjs",
    "perf:test": "node --test scripts/perf/*.test.mjs",
    "check:browser": "package-kit heavy 1 node scripts/perf/run.mjs --check"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "inline-measure": "^0.5.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@maxvyshniakov/package-kit": "1.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "oxlint": "1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxvyshniakov/text-truncate.git"
  }
}
