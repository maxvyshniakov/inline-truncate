{
  "name": "@skipstery/text-truncate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run --filter @skipstery/inline-measure build && rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:fast": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest --config vitest.config.ts run",
    "test:run": "vitest --config vitest.config.ts run src"
  },
  "dependencies": {
    "@skipstery/inline-measure": "workspace:*",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2",
    "@types/node": "26.3.0",
    "vite": "8.2.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "vitest": "4.1.11",
    "@testing-library/react": "16.3.2",
    "happy-dom": "20.11.6"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skipstery/ui.git",
    "directory": "packages/text-truncate"
  }
}
