+interface DocumentProbeRoot {
+  root: HTMLElement;
+  cleanupTimer?: ReturnType<typeof setTimeout>;
+}
+// Retain only an empty container between synchronous measurement sessions in
+// the same callback batch. Per-component strings and widths never enter here.
+const documentProbeRoots = new WeakMap<Document, DocumentProbeRoot>();
+function acquireProbeRoot(ownerDocument: Document) {
+  let entry = documentProbeRoots.get(ownerDocument);
+  if (entry && entry.root.parentElement !== ownerDocument.body) {
+    if (entry.cleanupTimer !== undefined) clearTimeout(entry.cleanupTimer);
+    entry = undefined;
+  }
+  if (!entry) {
+    const root = createInlineMeasurementRoot(ownerDocument);
+    // Isolate layout propagation, while preserving intrinsic text sizing.
+    // Size containment would invalidate the max-content measurement contract.
+    root.style.contain = "layout style";
+    entry = {root};
+    documentProbeRoots.set(ownerDocument, entry);
+    ownerDocument.body.append(root);
+  }
+  return entry;
+}
+function releaseProbeRoot(ownerDocument: Document, entry: DocumentProbeRoot) {
+  if (entry.cleanupTimer !== undefined) return;
+  entry.cleanupTimer = setTimeout(() => {
+    entry.cleanupTimer = undefined;
+    if (entry.root.childNodes.length) return;
+    entry.root.remove();
+    if (documentProbeRoots.get(ownerDocument) === entry) documentProbeRoots.delete(ownerDocument);
+  }, 0);
+}
